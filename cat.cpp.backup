#include "cat.h"
#include <opencv4/opencv2/opencv.hpp>
#include <opencv4/opencv2/video.hpp>
#include <opencv4/opencv2/objdetect.hpp>
#include <algorithm>
#include <onnxruntime_cxx_api.h>


cat::cat()
    : env(ORT_LOGGING_LEVEL_WARNING, "CatDetector"),
      sessionOptions(),
      session(nullptr)
{
    sessionOptions.SetIntraOpNumThreads(4);

    sessionOptions.SetGraphOptimizationLevel(
        GraphOptimizationLevel::ORT_ENABLE_ALL
    );

    OrtCUDAProviderOptions cuda_options{};
    cuda_options.device_id = 0;

    sessionOptions.AppendExecutionProvider_CUDA(cuda_options);

    const char* modelPath = "yolo11n.onnx";

    session = std::make_unique<Ort::Session>(
        env,
        modelPath,
        sessionOptions
    );
}
cat::state cat::detect(cv::Mat& frame)
{
    // --------------------------------
    // Calculate tile dimensions
    // --------------------------------

    int halfHeight = frame.rows / 2;
    int halfWidth  = frame.cols / 2;

    // --------------------------------
    // Create the five tiles
    // --------------------------------

    cv::Mat frameTL = frame(
        cv::Rect(
            0,
            0,
            halfWidth,
            halfHeight
        )
    );

    cv::Mat frameTR = frame(
        cv::Rect(
            halfWidth,
            0,
            halfWidth,
            halfHeight
        )
    );

    cv::Mat frameBL = frame(
        cv::Rect(
            0,
            halfHeight,
            halfWidth,
            halfHeight
        )
    );

    cv::Mat frameBR = frame(
        cv::Rect(
            halfWidth,
            halfHeight,
            halfWidth,
            halfHeight
        )
    );

    cv::Mat frameC = frame(
        cv::Rect(
            halfWidth / 2,
            halfHeight / 2,
            halfWidth,
            halfHeight
        )
    );

    // --------------------------------
    // Store all detections
    // --------------------------------

    std::vector<detection> detections;

    // --------------------------------
    // Top Left
    // --------------------------------
/*
    std::vector<detection> detectionsTL =
        detectOnTile(frameTL);

    for (auto& d : detectionsTL)
    {
        d.location = tile::TopLeft;

        // Local tile coordinates -> full frame
        d.box.x += 0;
        d.box.y += 0;

        detections.push_back(d);
    }

    // --------------------------------
    // Top Right
    // --------------------------------

    std::vector<detection> detectionsTR =
        detectOnTile(frameTR);

    for (auto& d : detectionsTR)
    {
        d.location = tile::TopRight;

        // Move box into full-frame coordinates
        d.box.x += halfWidth;
        d.box.y += 0;

        detections.push_back(d);
    }

    // --------------------------------
    // Bottom Left
    // --------------------------------

    std::vector<detection> detectionsBL =
        detectOnTile(frameBL);

    for (auto& d : detectionsBL)
    {
        d.location = tile::BottomLeft;

        // Move box into full-frame coordinates
        d.box.x += 0;
        d.box.y += halfHeight;

        detections.push_back(d);
    }

    // --------------------------------
    // Bottom Right
    // --------------------------------

    std::vector<detection> detectionsBR =
        detectOnTile(frameBR);

    for (auto& d : detectionsBR)
    {
        d.location = tile::BottomRight;

        // Move box into full-frame coordinates
        d.box.x += halfWidth;
        d.box.y += halfHeight;

        detections.push_back(d);
    }
*/
    // --------------------------------
    // Center
    // --------------------------------

    std::vector<detection> detectionsC =
        detectOnTile(frameC);

    for (auto& d : detectionsC)
    {
        d.location = tile::Center;

        // Center tile starts at:
        // x = halfWidth / 2
        // y = halfHeight / 2

        d.box.x += halfWidth / 2;
        d.box.y += halfHeight / 2;

        detections.push_back(d);
    }

    // --------------------------------
    // Draw bounding boxes
    // --------------------------------

    for (const auto& d : detections)
    {
        cv::rectangle(
            frame,
            d.box,
            cv::Scalar(0, 255, 0),
            3
        );

        std::string label =
            "Cat " + std::to_string(d.confidence);

        cv::putText(
            frame,
            label,
            cv::Point(
                d.box.x,
                d.box.y - 10
            ),
            cv::FONT_HERSHEY_SIMPLEX,
            0.7,
            cv::Scalar(0, 255, 0),
            2
        );
    }

    // --------------------------------
    // Determine state
    // --------------------------------

    if (detections.empty())
    {
        return state::NotFound;
    }

    return state::Found;
}




