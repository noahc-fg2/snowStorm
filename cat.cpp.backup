std::vector<cat::detection> cat::detectOnTile(
    const cv::Mat& subFrame)
{
    std::vector<cat::detection> detections;

    // -------------------------
    // Preprocess
    // -------------------------

    cat::PreprocessedFrame prepared =
        preprocessFrame(subFrame);

    cv::Mat preparedFrame = prepared.image;

    // -------------------------
    // Convert HWC -> CHW
    // -------------------------

    std::vector<float> inputTensorValues(
        3 * 640 * 640
    );

    for (int y = 0; y < 640; y++)
    {
        for (int x = 0; x < 640; x++)
        {
            cv::Vec3f pixel =
                preparedFrame.at<cv::Vec3f>(y, x);

            inputTensorValues[
                0 * 640 * 640 +
                y * 640 +
                x
            ] = pixel[0];

            inputTensorValues[
                1 * 640 * 640 +
                y * 640 +
                x
            ] = pixel[1];

            inputTensorValues[
                2 * 640 * 640 +
                y * 640 +
                x
            ] = pixel[2];
        }
    }

    // -------------------------
    // ONNX input tensor
    // -------------------------

    std::array<int64_t, 4> inputShape = {
        1, 3, 640, 640
    };

    Ort::MemoryInfo memoryInfo =
        Ort::MemoryInfo::CreateCpu(
            OrtArenaAllocator,
            OrtMemTypeDefault
        );

    Ort::Value inputTensor =
        Ort::Value::CreateTensor<float>(
            memoryInfo,
            inputTensorValues.data(),
            inputTensorValues.size(),
            inputShape.data(),
            inputShape.size()
        );

    // -------------------------
    // Run YOLO
    // -------------------------

    const char* inputNames[] = {
        "images"
    };

    const char* outputNames[] = {
        "output0"
    };

    auto outputTensors = session->Run(
        Ort::RunOptions{nullptr},
        inputNames,
        &inputTensor,
        1,
        outputNames,
        1
    );

    // -------------------------
    // Get YOLO output
    // -------------------------

    float* output =
        outputTensors[0].GetTensorMutableData<float>();

    constexpr int numCandidates = 8400;
    constexpr int numClasses = 80;

    // -------------------------
    // Decode detections
    // -------------------------

    for (int i = 0; i < numCandidates; i++)
    {
        float cx =
            output[0 * numCandidates + i];

        float cy =
            output[1 * numCandidates + i];

        float width =
            output[2 * numCandidates + i];

        float height =
            output[3 * numCandidates + i];

        // COCO class 15 = cat
        float confidence =
            output[(4 + 15) * numCandidates + i];

        //std::cout<< "Cat confidence: "<< confidence<< std::endl;
        if (confidence < 0.20f)
            continue;

        // YOLO coordinates are relative
        // to the 640x640 letterboxed image.
        float x1 =
            (cx - width / 2.0f
             - prepared.offsetX)
            / prepared.scale;

        float y1 =
            (cy - height / 2.0f
             - prepared.offsetY)
            / prepared.scale;

        float x2 =
            (cx + width / 2.0f
             - prepared.offsetX)
            / prepared.scale;

        float y2 =
            (cy + height / 2.0f
             - prepared.offsetY)
            / prepared.scale;

        int left =
            static_cast<int>(x1);

        int top =
            static_cast<int>(y1);

        int right =
            static_cast<int>(x2);

        int bottom =
            static_cast<int>(y2);

        cv::Rect box(
            left,
            top,
            right - left,
            bottom - top
        );

        // Keep the detection inside
        // the local tile.
        box &= cv::Rect(
            0,
            0,
            subFrame.cols,
            subFrame.rows
        );

        if (box.area() <= 0)
            continue;

        cat::detection detection;

        detection.classID = 15;
        detection.box = box;
        detection.confidence = confidence;

        detections.push_back(detection);
    }

    return detections;
}
   
cat::PreprocessedFrame cat::preprocessFrame(const cv::Mat& subFrame){
    PreprocessedFrame result;

    result.scale = std::min(
        640.0f / subFrame.cols,
        640.0f / subFrame.rows
    );

    const int newWidth = static_cast<int>(
        subFrame.cols * result.scale
    );

    const int newHeight = static_cast<int>(
        subFrame.rows * result.scale
    );

    result.offsetX = (640 - newWidth) / 2;
    result.offsetY = (640 - newHeight) / 2;

    cv::Mat resizedFrame;
    cv::resize(
        subFrame,
        resizedFrame,
        cv::Size(newWidth, newHeight)
    );

    // Initialize the entire canvas before copying into it.
    cv::Mat letterboxed(
        640, 640, CV_8UC3,
        cv::Scalar(114, 114, 114)
    );

    resizedFrame.copyTo(letterboxed(cv::Rect(
        result.offsetX,
        result.offsetY,
        newWidth,
        newHeight
    )));

    cv::Mat rgbFrame;
    cv::cvtColor(
        letterboxed,
        rgbFrame,
        cv::COLOR_BGR2RGB
    );

    rgbFrame.convertTo(
        result.image,
        CV_32FC3,
        1.0 / 255.0
    );

    return result;
}
